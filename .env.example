# Copy this file to .env and fill in your own key.
# config.py loads this automatically via python-dotenv.

OPENAI_API_KEY=sk-your-openai-api-key-here
#OPENAI_MODEL=gpt-4o-mini
#LOG_LEVEL=INFO

# --- LangSmith tracing (optional) ---
# Get a key at https://smith.langchain.com. Uncomment all three to enable.
# No code change needed beyond this -- every ChatOpenAI call and every
# LangGraph node becomes a nested trace automatically, since LangChain reads
# these env vars directly (core/config.py's load_dotenv() runs before any
# LLM/graph call, so this file alone is enough). See
# docs/design/langgraph-workflow.md's "Observability" note for what gets
# tagged and how to read the traces.
#LANGSMITH_TRACING=true
#LANGSMITH_API_KEY=lsv2_your-langsmith-api-key-here
#LANGSMITH_PROJECT=finnie
